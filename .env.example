# Supabase project used for sync. Both values are public by design: data is
# protected by row-level security (supabase/schema.sql), not by hiding these.
# Sync UI stays hidden until both are set. Copy this file to .env and fill in.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public half of the web push (VAPID) key pair; the private half is a Supabase function secret.
VITE_VAPID_PUBLIC_KEY=

# Grafana Faro collector for frontend observability. Public by design: Grafana
# accepts data only from the CORS origins allowed in the Faro app. Empty = off.
VITE_FARO_URL=
